# Copy to .env and fill in. Never commit .env.
AWS_PROFILE=default
SCR_BUCKET=your-bucket-name

# local = DuckDB on your machine (no account); dev = Snowflake
DBT_TARGET=local
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=DBT_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/your_mac_user/.snowflake/keys/dbt_svc_key.p8
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=CREDITO_WH
SNOWFLAKE_DATABASE=CREDITO

# LLM summary (python -m ai.run). Optional: LLM_MODEL overrides the default model.
ANTHROPIC_API_KEY=
