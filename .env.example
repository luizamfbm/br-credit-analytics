# Copy to .env and fill in. Never commit .env.
AWS_PROFILE=default
SCR_BUCKET=your-bucket-name

DBT_TARGET=dev
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=DBT_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/your_mac_user/.snowflake/keys/dbt_svc_key.p8
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=CREDITO_WH
SNOWFLAKE_DATABASE=CREDITO
