{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadScrFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::<BUCKET>/raw/scr_data/*"
    },
    {
      "Sid": "ListScrPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::<BUCKET>",
      "Condition": { "StringLike": { "s3:prefix": ["raw/scr_data/*"] } }
    }
  ]
}
